---
interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { href = '/', size = 'md' } = Astro.props;
---
<a class={`wordmark wordmark-${size}`} href={href} aria-label="ERCs, Solved home">
  ERCs, Solved<span class="period" aria-hidden="true">.</span>
</a>

<style>
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink-bone);
    font-variation-settings: 'opsz' 14;
  }
  .wordmark-sm { font-size: var(--t-mono-lg); }
  .wordmark-md { font-size: 22px; }
  .wordmark-lg { font-size: var(--t-serif-1); }
  .wordmark .period {
    color: var(--signal-pink-bright);
    transition: color 200ms ease;
    animation: ercs-period-pulse 3.6s ease-in-out infinite;
  }
  .wordmark:hover .period { color: var(--erc-sand); }

  @keyframes ercs-period-pulse {
    0%, 100% { opacity: 0.7; }
    50%      { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark .period { animation: none; opacity: 1; }
  }
</style>
