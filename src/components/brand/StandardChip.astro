---
interface Props {
  kind: 'erc' | 'eip' | 'lsp' | 'topic';
  id: string | number;
  emphasis?: 'normal' | 'strong';
}
const { kind, id, emphasis = 'normal' } = Astro.props;
const label = kind === 'lsp'
  ? `LSP${id}`
  : kind === 'eip'
    ? `EIP-${id}`
    : kind === 'topic'
      ? String(id)
      : id === 'EOA'
        ? 'EOA'
        : id === 'other'
          ? 'EVM'
          : `ERC-${id}`;
---
<span class={`chip chip-${kind} chip-${emphasis}`}>{label}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--s-2);
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    line-height: 1.4;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .chip-erc, .chip-eip, .chip-topic { color: var(--erc-sand); }
  .chip-lsp { color: var(--signal-pink); }
  .chip-strong { font-weight: 500; }
</style>
