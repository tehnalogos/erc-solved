---
interface Criterion {
  name: string;
  evaluates: string;
}
interface Props {
  criteria: Criterion[];
  heading?: string;
}
const { criteria, heading = 'Criteria framework' } = Astro.props;
---
<section class="criteria">
  <h2>{heading}.</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Criterion</th>
          <th>What it evaluates</th>
        </tr>
      </thead>
      <tbody>
        {criteria.map((c) => (
          <tr>
            <th scope="row">{c.name}</th>
            <td>{c.evaluates}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .criteria { display: grid; gap: var(--s-4); }
  .criteria h2 { font-size: var(--t-serif-1); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--ink-line); background: var(--ink-paper); }
  table { width: 100%; min-width: 520px; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--t-mono-sm); }
  th, td {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--ink-line);
    text-align: left;
    vertical-align: top;
    color: var(--ink-bone-dim);
    line-height: 1.6;
  }
  thead th { color: var(--ink-bone); background: var(--ink-black); }
  tbody th { font-weight: 500; color: var(--ink-bone); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
</style>
