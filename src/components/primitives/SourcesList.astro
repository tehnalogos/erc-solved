---
import Crossref from './Crossref.astro';
interface Source {
  label: string;
  href: string;
}
interface Props {
  sources: Source[];
  heading?: string;
}
const { sources, heading = 'Primary sources' } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources">
    <h2>{heading}.</h2>
    <ul>
      {sources.map((s) => (
        <li><Crossref href={s.href}>{s.label}</Crossref></li>
      ))}
    </ul>
  </section>
)}

<style>
  .sources {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .sources h2 { font-size: var(--t-serif-1); }
  .sources ul { display: grid; gap: var(--s-2); }
</style>
