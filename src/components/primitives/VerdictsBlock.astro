---
import { slugify } from '~/lib/seo';

interface Verdict {
  contender: string;
  when: string;
}
interface Props {
  verdicts: Verdict[];
  luksoLabel?: string;
  heading?: string;
  idPrefix?: string;
}
const { verdicts, luksoLabel = 'LUKSO', heading = 'When each wins', idPrefix } = Astro.props;
---
<section class="verdicts">
  <h2>{heading}.</h2>
  <ul class="grid">
    {verdicts.map((v) => (
      <li
        id={idPrefix ? `${idPrefix}${slugify(v.contender)}` : undefined}
        class:list={['card', { 'is-lukso': v.contender === luksoLabel }]}
      >
        <span class="head">When {v.contender} wins</span>
        <p>{v.when}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .verdicts { display: grid; gap: var(--s-4); }
  .verdicts h2 { font-size: var(--t-serif-1); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-3);
  }
  .card {
    border: 1px solid var(--ink-line);
    border-left: 2px solid var(--erc-sand);
    background: var(--ink-paper);
    padding: var(--s-3) var(--s-4);
    display: grid;
    gap: var(--s-2);
  }
  .card.is-lukso { border-left-color: var(--signal-pink); }
  .head {
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--erc-sand);
  }
  .card.is-lukso .head { color: var(--signal-pink); }
  .card p {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--ink-bone-dim);
    line-height: 1.6;
    margin: 0;
  }
</style>
