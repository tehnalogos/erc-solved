---
interface TestResult {
  chain: string;
  value: string;
  source?: string;
}
interface Test {
  name: string;
  description: string;
  unit?: string;
  results: TestResult[];
}
interface Props {
  chains: string[];
  tests: Test[];
  heading?: string;
  luksoColumn?: string;
}
const { chains, tests, heading = 'Results', luksoColumn = 'LUKSO' } = Astro.props;
---
<section class="bench">
  <h2>{heading}.</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Test</th>
          {chains.map((c) => (
            <th class:list={{ 'col-lukso': c === luksoColumn }}>{c}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {tests.map((t) => (
          <tr>
            <th scope="row">
              <span class="name">{t.name}</span>
              {t.unit && <span class="unit">{t.unit}</span>}
              <span class="desc">{t.description}</span>
            </th>
            {chains.map((c) => {
              const r = t.results.find((x) => x.chain === c);
              return (
                <td class:list={{ 'cell-lukso': c === luksoColumn }}>
                  <span class="val">{r?.value ?? '—'}</span>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .bench { display: grid; gap: var(--s-4); }
  .bench h2 { font-size: var(--t-serif-1); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--ink-line); background: var(--ink-paper); }
  table {
    width: 100%;
    min-width: 880px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
  }
  th, td {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--ink-line);
    border-right: 1px solid var(--ink-line);
    text-align: left;
    vertical-align: top;
    color: var(--ink-bone-dim);
    line-height: 1.55;
  }
  thead th { color: var(--ink-bone); background: var(--ink-black); font-weight: 500; }
  thead th.col-lukso { color: var(--signal-pink); }
  tbody th {
    font-weight: 500;
    color: var(--ink-bone);
    width: 34%;
    max-width: 32ch;
    display: grid;
    gap: var(--s-1);
  }
  tbody th .name { color: var(--ink-bone); }
  tbody th .unit {
    font-size: var(--t-mono-xs);
    color: var(--ink-fog);
    text-transform: lowercase;
  }
  tbody th .desc {
    font-size: var(--t-mono-xs);
    color: var(--ink-bone-dim);
    font-weight: 400;
  }
  td .val { color: var(--ink-bone); }
  td.cell-lukso .val { color: var(--signal-pink); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  th:last-child, td:last-child { border-right: 0; }
</style>
