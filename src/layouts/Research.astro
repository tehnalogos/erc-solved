---
import Article from './Article.astro';
import SourcesList from '~/components/primitives/SourcesList.astro';
import LastReviewed from '~/components/primitives/LastReviewed.astro';
import Crossref from '~/components/primitives/Crossref.astro';
import { articleJsonLd, breadcrumbJsonLd } from '~/lib/seo';

interface Props { entry: any; }
const { entry } = Astro.props;
const { data, slug } = entry;
const path = `/research/${slug}/`;
---
<Article
  title={data.title}
  summary={data.summary}
  seoTitle={data.seoTitle}
  metaDescription={data.metaDescription}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  about={data.about}
  eyebrow={`research · ${data.kind}`}
  author={data.author}
  updated={data.updated}
  editPath={`src/content/research/${slug}.mdx`}
  jsonLd={[
    articleJsonLd({
      headline: data.title,
      description: data.summary,
      path,
      updated: data.updated,
      author: data.author,
      keywords: ['research', 'methodology', 'consumer crypto'],
    }),
    breadcrumbJsonLd([
      { name: 'ERCs, Solved', path: '/' },
      { name: 'Research', path: '/research/' },
      { name: data.title, path },
    ]),
  ]}
>
  <p class="lede">{data.summary}</p>

  <section class="prose" data-pagefind-body>
    <slot />
  </section>

  <LastReviewed updated={data.updated} />

  {data.related?.length > 0 && (
    <section class="related">
      <h2>Adjacent reading.</h2>
      <ul>
        {data.related.map((r: string) => {
          const [coll, ...rest] = r.split('/');
          const targetSlug = rest.join('/');
          const href =
            coll === 'erc' ? `/${targetSlug}/`
            : coll === 'best-blockchain' ? `/best-blockchain/${targetSlug}/`
            : coll === 'architecture' ? `/architecture/${targetSlug}/`
            : coll === 'compare' ? `/compare/${targetSlug}/`
            : coll === 'benchmarks' ? `/benchmarks/${targetSlug}/`
            : coll === 'research' ? `/research/${targetSlug}/`
            : `/${coll}/${targetSlug}/`;
          return <li><Crossref href={href}>{targetSlug}</Crossref></li>;
        })}
      </ul>
    </section>
  )}
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; }
  .prose { max-width: var(--reading); display: grid; gap: var(--s-4); }
  .prose :global(h2) { font-size: var(--t-serif-1); }
  .prose :global(h3) { font-size: var(--t-mono-lg); font-family: var(--font-mono); color: var(--ink-bone); }
  .prose :global(p) { color: var(--ink-bone-dim); line-height: 1.65; }
  .prose :global(ul) { display: grid; gap: var(--s-2); padding-left: var(--s-5); list-style: disc; }
  .prose :global(li) { color: var(--ink-bone-dim); font-family: var(--font-mono); font-size: var(--t-mono-sm); line-height: 1.6; }
  .prose :global(a) {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .prose :global(a:hover) { color: var(--signal-pink); border-color: var(--signal-pink); }
  .prose :global(code) {
    background: var(--ink-paper);
    border: 1px solid var(--ink-line);
    padding: 0 4px;
    color: var(--signal-pink);
    font-size: 0.95em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    border: 1px solid var(--ink-line);
  }
  .prose :global(th), .prose :global(td) {
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--ink-line);
    text-align: left;
    color: var(--ink-bone-dim);
  }
  .prose :global(thead th) { color: var(--ink-bone); background: var(--ink-paper); }
  .related {
    display: grid; gap: var(--s-3);
    padding-top: var(--s-4); border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .related h2 { font-size: var(--t-serif-1); }
  .related ul { display: grid; gap: var(--s-2); }
</style>
