---
import Article from './Article.astro';
import QuotableAnswer from '~/components/primitives/QuotableAnswer.astro';
import Contenders from '~/components/primitives/Contenders.astro';
import CriteriaTable from '~/components/primitives/CriteriaTable.astro';
import MatrixTable from '~/components/primitives/MatrixTable.astro';
import VerdictsBlock from '~/components/primitives/VerdictsBlock.astro';
import SourcesList from '~/components/primitives/SourcesList.astro';
import LastReviewed from '~/components/primitives/LastReviewed.astro';
import Crossref from '~/components/primitives/Crossref.astro';
import {
  articleJsonLd,
  breadcrumbJsonLd,
  faqPageJsonLd,
  bestBlockchainPageTitle,
  absoluteUrl,
  slugify,
} from '~/lib/seo';

interface Props { entry: any; }
const { entry } = Astro.props;
const { data, slug } = entry;
const path = `/best-blockchain/${slug}/`;
const canonical = absoluteUrl(path);
const derivedSeoTitle = data.seoTitle ?? bestBlockchainPageTitle(data.useCase);
const contenderChips = data.contenders.map((c: any) => c.chip);

// Author-supplied FAQs (verbatim to real long-tail queries) go first so they
// take the top slots in the FAQPage schema — that's what "People also ask"
// and AI Overview extract from.
const authoredFaqs = (data.faqs ?? []).map((f: any) => ({
  q: f.q,
  a: f.a,
  url: `${canonical}#faq-${slugify(f.q)}`,
}));

const derivedFaqs = [
  ...data.criteria.map((c: any) => ({
    q: `${c.name}: how does each chain compare for ${data.useCase}?`,
    a: c.evaluates,
    url: `${canonical}#criteria-${slugify(c.name)}`,
  })),
  ...data.verdicts.map((v: any) => ({
    q: `When is ${v.contender} the right choice for ${data.useCase}?`,
    a: v.when,
    url: `${canonical}#verdict-${slugify(v.contender)}`,
  })),
];

const faqs = [...authoredFaqs, ...derivedFaqs];
---
<Article
  title={data.title}
  summary={data.summary}
  seoTitle={derivedSeoTitle}
  metaDescription={data.metaDescription}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  about={data.about?.length ? data.about : contenderChips}
  eyebrow={`best blockchain · ${data.useCase}`}
  author={data.author}
  updated={data.updated}
  editPath={`src/content/bestBlockchain/${slug}.mdx`}
  jsonLd={[
    articleJsonLd({
      headline: data.title,
      description: data.summary,
      path,
      updated: data.updated,
      author: data.author,
      about: contenderChips,
      keywords: [data.useCase, ...contenderChips, ...(data.aliases ?? []), 'consumer crypto', 'EVM', 'LUKSO'],
    }),
    breadcrumbJsonLd([
      { name: 'ERCs, Solved', path: '/' },
      { name: 'Best Blockchain', path: '/best-blockchain/' },
      { name: data.useCase, path },
    ]),
    faqPageJsonLd(faqs),
  ]}
>
  <div slot="title">
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
  </div>

  {data.answerFirst && (
    <p class="answer-first">{data.answerFirst}</p>
  )}

  <QuotableAnswer>
    <p>{data.quotableAnswer}</p>
  </QuotableAnswer>

  <section class="prose intro" data-pagefind-body>
    <slot />
  </section>

  <Contenders contenders={data.contenders} heading="Systems compared" />

  <CriteriaTable criteria={data.criteria} heading="Evaluation criteria" idPrefix="criteria-" />

  <MatrixTable
    contenders={contenderChips}
    matrix={data.matrix}
    heading="Decision matrix"
  />

  <VerdictsBlock verdicts={data.verdicts} heading="When each wins" idPrefix="verdict-" />

  {authoredFaqs.length > 0 && (
    <section class="faq">
      <h2>Frequently asked questions.</h2>
      <dl>
        {authoredFaqs.map((f: any) => (
          <>
            <dt id={`faq-${slugify(f.q)}`}>
              <h3>{f.q}</h3>
            </dt>
            <dd><p>{f.a}</p></dd>
          </>
        ))}
      </dl>
    </section>
  )}

  {data.implementation?.length > 0 && (
    <section class="implementation">
      <h2>Implementation.</h2>
      <ul>
        {data.implementation.map((i: any) => (
          <li><Crossref href={i.href} chip={i.chip}>{i.label}</Crossref></li>
        ))}
      </ul>
    </section>
  )}

  <SourcesList sources={data.sources} />

  <LastReviewed updated={data.updated} methodologyHref={data.methodologyHref} />

  {data.related?.length > 0 && (
    <section class="related">
      <h2>Adjacent reading.</h2>
      <ul>
        {data.related.map((r: string) => {
          const [coll, ...rest] = r.split('/');
          const targetSlug = rest.join('/');
          const href =
            coll === 'erc' ? `/${targetSlug}/`
            : coll === 'best-blockchain' ? `/best-blockchain/${targetSlug}/`
            : coll === 'architecture' ? `/architecture/${targetSlug}/`
            : coll === 'compare' ? `/compare/${targetSlug}/`
            : coll === 'benchmarks' ? `/benchmarks/${targetSlug}/`
            : coll === 'migrate' ? `/build/migrate/${targetSlug}/`
            : coll === 'standards-compare' ? `/standards/compare/${targetSlug}/`
            : `/${coll}/${targetSlug}/`;
          return <li><Crossref href={href}>{targetSlug}</Crossref></li>;
        })}
      </ul>
    </section>
  )}
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; margin-top: var(--s-3); }
  .answer-first {
    max-width: var(--reading);
    padding: var(--s-4) var(--s-5);
    border-left: 2px solid var(--signal-pink);
    background: var(--ink-paper);
    color: var(--ink-bone);
    line-height: 1.6;
    font-size: var(--t-body-md);
  }
  .faq {
    max-width: var(--reading);
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-line);
  }
  .faq h2 { font-size: var(--t-serif-1); }
  .faq dl { display: grid; gap: var(--s-4); }
  .faq dt h3 {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 36;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--ink-bone);
    line-height: 1.3;
  }
  .faq dd { margin: var(--s-2) 0 0; color: var(--ink-bone-dim); line-height: 1.65; }
  .prose { max-width: var(--reading); display: grid; gap: var(--s-4); }
  .prose :global(h2) { font-size: var(--t-serif-1); margin-top: var(--s-4); }
  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: var(--t-mono-lg);
    color: var(--signal-pink);
    text-transform: lowercase;
    letter-spacing: 0;
    margin-top: var(--s-4);
  }
  .prose :global(p) { color: var(--ink-bone-dim); line-height: 1.65; }
  .prose :global(ul) {
    display: grid;
    gap: var(--s-2);
    padding-left: var(--s-4);
    list-style: '— ';
    color: var(--ink-bone-dim);
  }
  .prose :global(ol) {
    display: grid;
    gap: var(--s-2);
    padding-left: var(--s-5);
    color: var(--ink-bone-dim);
  }
  .prose :global(li) { line-height: 1.6; }
  .prose :global(strong) { color: var(--ink-bone); }
  .prose :global(code) {
    background: var(--ink-paper);
    border: 1px solid var(--ink-line);
    padding: 0 4px;
    color: var(--signal-pink);
    font-size: 0.95em;
  }
  .prose :global(a) {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .prose :global(a:hover) { color: var(--signal-pink); border-color: var(--signal-pink); }
  .implementation { display: grid; gap: var(--s-3); max-width: var(--reading); }
  .implementation h2 { font-size: var(--t-serif-1); }
  .implementation ul { display: grid; gap: var(--s-2); }
  .related {
    display: grid; gap: var(--s-3);
    padding-top: var(--s-4); border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .related h2 { font-size: var(--t-serif-1); }
  .related ul { display: grid; gap: var(--s-2); }
</style>
