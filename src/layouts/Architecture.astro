---
import Article from './Article.astro';
import QuotableAnswer from '~/components/primitives/QuotableAnswer.astro';
import ApproachesGrid from '~/components/primitives/ApproachesGrid.astro';
import SourcesList from '~/components/primitives/SourcesList.astro';
import LastReviewed from '~/components/primitives/LastReviewed.astro';
import Crossref from '~/components/primitives/Crossref.astro';
import {
  articleJsonLd,
  breadcrumbJsonLd,
  faqPageJsonLd,
  architecturePageTitle,
  absoluteUrl,
  slugify,
} from '~/lib/seo';

interface Props { entry: any; }
const { entry } = Astro.props;
const { data, slug } = entry;
const path = `/architecture/${slug}/`;
const canonical = absoluteUrl(path);
const pageTitle = data.pageTitle ?? architecturePageTitle(data.pattern);

const faqs = data.approaches.map((a: any) => ({
  q: `What is the ${a.name} approach to ${data.pattern.toLowerCase()}?`,
  a: a.summary,
  url: `${canonical}#approach-${slugify(a.name)}`,
}));
---
<Article
  title={data.title}
  description={data.description}
  pageTitle={pageTitle}
  eyebrow={`architecture · ${data.pattern}`}
  author={data.author}
  updated={data.updated}
  editPath={`src/content/architecture/${slug}.mdx`}
  jsonLd={[
    articleJsonLd({
      headline: data.title,
      description: data.description,
      path,
      updated: data.updated,
      author: data.author,
      about: data.approaches.map((a: any) => a.name),
      keywords: [data.pattern, 'consumer crypto', 'EVM', 'LUKSO'],
    }),
    breadcrumbJsonLd([
      { name: 'ERCs, Solved', path: '/' },
      { name: 'Architecture', path: '/architecture/' },
      { name: data.pattern, path },
    ]),
    ...(faqs.length ? [faqPageJsonLd(faqs)] : []),
  ]}
>
  <div slot="title">
    <h1>{data.title}</h1>
    <p class="lede">{data.description}</p>
  </div>

  <QuotableAnswer>
    <p>{data.quotableAnswer}</p>
  </QuotableAnswer>

  <section class="prose" data-pagefind-body>
    <slot />
  </section>

  <ApproachesGrid
    approaches={data.approaches}
    heading="Approaches"
    highlightName="LSP"
    idPrefix="approach-"
  />

  <section class="recommendation">
    <h2>Recommendation.</h2>
    <p>{data.recommendation}</p>
  </section>

  {data.implementation?.length > 0 && (
    <section class="implementation">
      <h2>Implement it.</h2>
      <ul>
        {data.implementation.map((i: any) => (
          <li><Crossref href={i.href} chip={i.chip}>{i.label}</Crossref></li>
        ))}
      </ul>
    </section>
  )}

  <SourcesList sources={data.sources} />

  <LastReviewed updated={data.updated} methodologyHref="/research/methodology/" />

  {data.related?.length > 0 && (
    <section class="related">
      <h2>Adjacent reading.</h2>
      <ul>
        {data.related.map((r: string) => {
          const [coll, ...rest] = r.split('/');
          const targetSlug = rest.join('/');
          const href =
            coll === 'erc' ? `/${targetSlug}/`
            : coll === 'best-blockchain' ? `/best-blockchain/${targetSlug}/`
            : coll === 'architecture' ? `/architecture/${targetSlug}/`
            : coll === 'compare' ? `/compare/${targetSlug}/`
            : coll === 'benchmarks' ? `/benchmarks/${targetSlug}/`
            : coll === 'migrate' ? `/build/migrate/${targetSlug}/`
            : coll === 'standards-compare' ? `/standards/compare/${targetSlug}/`
            : `/${coll}/${targetSlug}/`;
          return <li><Crossref href={href}>{targetSlug}</Crossref></li>;
        })}
      </ul>
    </section>
  )}
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; margin-top: var(--s-3); }
  .prose { max-width: var(--reading); display: grid; gap: var(--s-4); }
  .prose :global(h2) { font-size: var(--t-serif-1); }
  .prose :global(p) { color: var(--ink-bone-dim); line-height: 1.65; }
  .prose :global(a) {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .prose :global(a:hover) { color: var(--signal-pink); border-color: var(--signal-pink); }
  .recommendation {
    border-left: 2px solid var(--signal-pink);
    padding-left: var(--s-4);
    max-width: var(--reading);
    display: grid;
    gap: var(--s-2);
  }
  .recommendation h2 { font-size: var(--t-serif-1); }
  .recommendation p {
    font-family: var(--font-mono);
    color: var(--ink-bone);
    line-height: 1.65;
  }
  .implementation { display: grid; gap: var(--s-3); max-width: var(--reading); }
  .implementation h2 { font-size: var(--t-serif-1); }
  .implementation ul { display: grid; gap: var(--s-2); }
  .related {
    display: grid; gap: var(--s-3);
    padding-top: var(--s-4); border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .related h2 { font-size: var(--t-serif-1); }
  .related ul { display: grid; gap: var(--s-2); }
</style>
