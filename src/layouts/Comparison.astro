---
import Article from './Article.astro';
import Verdict from '~/components/primitives/Verdict.astro';
import QuotableAnswer from '~/components/primitives/QuotableAnswer.astro';
import Crossref from '~/components/primitives/Crossref.astro';
import { breadcrumbJsonLd, comparisonPageTitle, techArticleJsonLd } from '~/lib/seo';

interface Props { entry: any; }
const { entry } = Astro.props;
const { data, slug } = entry;
const pageTitle = comparisonPageTitle(data.left.chip, data.right.chip);
const comparePath = `/standards/compare/${slug}/`;
const canonical = data.canonical
  ? new URL(data.canonical, Astro.site).toString()
  : undefined;
---
<Article
  title={pageTitle}
  description={data.description}
  pageTitle={pageTitle}
  eyebrow="comparison · spec-grade diff"
  author={data.author}
  updated={data.updated}
  editPath={`src/content/compare/${slug}.mdx`}
  canonical={canonical}
  jsonLd={[
    techArticleJsonLd({
      headline: pageTitle,
      description: data.quotableAnswer ?? data.description,
      path: comparePath,
      updated: data.updated,
      author: data.author,
      about: [data.left.chip, data.right.chip, 'Ethereum', 'EVM', 'LUKSO Standards'],
    }),
    breadcrumbJsonLd([
      { name: 'ERCs, Solved', path: '/' },
      { name: 'Standards', path: '/standards/' },
      { name: `${data.left.chip} vs ${data.right.chip}`, path: comparePath },
    ]),
  ]}
>
  <div slot="title" class="vs">
    <h1>
      <span class="left">{data.left.chip}</span>
      <span class="vs-word">vs</span>
      <span class="right">{data.right.chip}</span>
      <span class="scope">Ethereum/EVM standard comparison</span>
    </h1>
    <p class="lede">{data.description}</p>
  </div>

  {data.quotableAnswer && (
    <QuotableAnswer label="quotable answer">
      <p>{data.quotableAnswer}</p>
    </QuotableAnswer>
  )}

  <div class="verdict-grid">
    <Verdict tone="use-erc" label={`use ${data.left.chip}`}>
      <p>{data.verdict.useLeft}</p>
    </Verdict>
    <Verdict tone="use-lsp" label={`use ${data.right.chip}`}>
      <p>{data.verdict.useRight}</p>
    </Verdict>
    {data.verdict.neither && (
      <Verdict tone="either" label="neither">
        <p>{data.verdict.neither}</p>
      </Verdict>
    )}
  </div>

  {data.matrix?.length > 0 && (
    <section class="matrix">
      <h2>Spec diff.</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th></th>
              <th><span class="chip-erc">{data.left.chip}</span></th>
              <th><span class="chip-lsp">{data.right.chip}</span></th>
            </tr>
          </thead>
          <tbody>
            {data.matrix.map((row: any) => (
              <tr>
                <th scope="row">{row.row}</th>
                <td>{row.left}</td>
                <td>{row.right}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="prose">
    <slot />
  </section>

  {data.docs?.length > 0 && (
    <section class="docs">
      <h2>Read the source.</h2>
      <ul>{data.docs.map((d: any) => <li><Crossref href={d.href}>{d.label}</Crossref></li>)}</ul>
    </section>
  )}

  {data.related?.length > 0 && (
    <section class="related">
      <h2>Adjacent reading.</h2>
      <ul>
        {data.related.map((r: string) => {
          const [coll, ...rest] = r.split('/');
          const targetSlug = rest.join('/');
          const href =
            coll === 'erc' ? `/${targetSlug}/`
            : coll === 'migrate' ? `/build/migrate/${targetSlug}/`
            : coll === 'compare' ? `/standards/compare/${targetSlug}/`
            : `/${coll}/${targetSlug}/`;
          return <li><Crossref href={href}>{targetSlug}</Crossref></li>;
        })}
      </ul>
    </section>
  )}
</Article>

<style>
  .vs { display: grid; gap: var(--s-3); }
  .vs h1 {
    display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: baseline;
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 60;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
  }
  .left { color: var(--erc-sand); }
  .right { color: var(--signal-pink); }
  .vs-word { color: var(--ink-fog); font-family: var(--font-mono); font-size: 0.45em; }
  .scope {
    flex-basis: 100%;
    color: var(--ink-fog);
    font-family: var(--font-mono);
    font-size: var(--t-mono-md);
    letter-spacing: 0;
    text-transform: lowercase;
  }
  .lede { color: var(--ink-bone-dim); max-width: 72ch; }

  .verdict-grid { display: grid; gap: var(--s-3); grid-template-columns: 1fr 1fr; }
  .verdict-grid > :global(*) { min-width: 0; }
  @media (max-width: 720px) { .verdict-grid { grid-template-columns: 1fr; } }

  .matrix { display: grid; gap: var(--s-4); }
  .matrix h2 { font-size: var(--t-serif-1); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--ink-line); background: var(--ink-paper); }
  table { width: 100%; min-width: 640px; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--t-mono-sm); }
  th, td { padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--ink-line); text-align: left; vertical-align: top; color: var(--ink-bone-dim); line-height: 1.6; }
  thead th { color: var(--ink-bone); background: var(--ink-black); }
  tbody th { font-weight: 500; color: var(--ink-bone); text-transform: lowercase; }
  td:nth-child(2) { color: var(--erc-sand); }
  td:nth-child(3) { color: var(--signal-pink); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  .chip-erc { color: var(--erc-sand); padding: 2px var(--s-2); border: 1px solid currentColor; font-size: var(--t-mono-xs); }
  .chip-lsp { color: var(--signal-pink); padding: 2px var(--s-2); border: 1px solid currentColor; font-size: var(--t-mono-xs); }

  .prose { max-width: var(--reading); display: grid; gap: var(--s-5); }
  .prose :global(h2) { font-size: var(--t-serif-1); }
  .prose :global(p) { color: var(--ink-bone-dim); }
  .prose :global(code) { background: var(--ink-paper); border: 1px solid var(--ink-line); padding: 0 4px; color: var(--signal-pink); font-size: 0.95em; }

  .docs, .related { display: grid; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--ink-line); max-width: var(--reading); }
  .docs ul, .related ul { display: grid; gap: var(--s-2); }
</style>
