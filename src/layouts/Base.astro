---
import '~/styles/tokens.css';
import '~/styles/reset.css';
import '~/styles/type.css';
import '~/styles/motion.css';
import '~/styles/commandk.css';
import Header from '~/components/nav/Header.astro';
import Footer from '~/components/nav/Footer.astro';
import CommandK from '~/components/search/CommandK.tsx';
import Analytics from '@vercel/analytics/astro';

// The four content layers this layout resolves:
//   Display  → `title` (browser tab / RSS / pagefind fallback)
//   SERP     → `seoTitle` + `metaDescription`  (Google/Bing SERP + <title>)
//   Social   → `ogTitle`  + `ogDescription`    (OG / Twitter card overrides)
//   GEO/LLM  → `summary`  + `about[]`          (JSON-LD, llms-full.txt)
// Each layer falls back to the previous, so authors typically only fill
// `title` + `summary` and the rest resolves automatically.
interface Props {
  title: string;
  summary?: string;
  seoTitle?: string;
  metaDescription?: string;
  ogTitle?: string;
  ogDescription?: string;
  about?: string[];
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string | false;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** @deprecated use `metaDescription` (SERP) or `summary` (GEO). Kept for
   * transitional call sites; forwarded as `metaDescription` when set. */
  description?: string;
}
const {
  title,
  summary,
  seoTitle,
  metaDescription,
  ogTitle,
  ogDescription,
  about = [],
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogType = 'website',
  ogImage = '/og/ercs-solved.png',
  jsonLd,
  description,
  noindex = false,
} = Astro.props;

const seoTitleResolved = seoTitle ?? title;
const fullTitle = seoTitleResolved.endsWith('ERCs, Solved') || seoTitleResolved.endsWith('ERCs, Solved.')
  ? seoTitleResolved
  : `${seoTitleResolved} · ERCs, Solved`;

// Sentence-boundary truncator for auto-derived meta descriptions. Keeps
// snippets from ending mid-word when authors haven't hand-written one.
function truncateSmart(text: string, max: number): string {
  if (text.length <= max) return text;
  const slice = text.slice(0, max);
  const lastSentence = Math.max(slice.lastIndexOf('. '), slice.lastIndexOf('! '), slice.lastIndexOf('? '));
  if (lastSentence > max * 0.6) return slice.slice(0, lastSentence + 1);
  const lastSpace = slice.lastIndexOf(' ');
  return (lastSpace > 0 ? slice.slice(0, lastSpace) : slice) + '…';
}

const metaDescriptionResolved =
  metaDescription ??
  description ??
  (summary ? truncateSmart(summary, 160) : '');
const ogTitleResolved = ogTitle ?? fullTitle;
const ogDescriptionResolved = ogDescription ?? metaDescriptionResolved;
const jsonLdDescription = summary ?? metaDescriptionResolved;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.ercsolved.dev';
const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ERCs, Solved',
    url: siteUrl,
    description: 'A field manual for Ethereum ERC problems and the LUKSO LSP standards that solve them.',
    publisher: { '@type': 'Organization', name: 'ERCs, Solved', url: siteUrl },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ERCs, Solved',
    alternateName: 'ercsolved.dev',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    description:
      'Independent developer reference mapping Ethereum ERC standards to the LUKSO LSP standards that address their limitations.',
    sameAs: [
      'https://github.com/tehnalogos/erc-solved',
    ],
  },
];
const jsonLdPayload = jsonLd
  ? [...siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : siteJsonLd;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescriptionResolved} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large'} />

    <meta property="og:title" content={ogTitleResolved} />
    <meta property="og:description" content={ogDescriptionResolved} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ERCs, Solved" />
    {absoluteOgImage && (
      <>
        <meta property="og:image" content={absoluteOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content="ERCs, Solved - Ethereum ERC problems and LUKSO LSP solutions" />
      </>
    )}
    <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitleResolved} />
    <meta name="twitter:description" content={ogDescriptionResolved} />
    {absoluteOgImage && (
      <>
        <meta name="twitter:image" content={absoluteOgImage} />
        <meta name="twitter:image:alt" content="ERCs, Solved - Ethereum ERC problems and LUKSO LSP solutions" />
      </>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="ERCs, Solved — Updates" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>
    <CommandK client:idle />
    <Analytics />

    <script>
      // Scroll-triggered reveals
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).dataset.reveal = 'on';
              obs.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
