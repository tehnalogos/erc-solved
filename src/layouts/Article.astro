---
import Base from './Base.astro';
import Authorship from '~/components/primitives/Authorship.astro';

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
  eyebrow?: string;
  author?: string;
  updated?: Date | string;
  editPath?: string;
  ogType?: 'website' | 'article';
}
const {
  title,
  description,
  pageTitle = title,
  eyebrow,
  author,
  updated,
  editPath,
  ogType = 'article',
} = Astro.props;

const editHref = editPath
  ? `https://github.com/lukso-network/ercs-solved/edit/main/${editPath}`
  : undefined;
---
<Base title={pageTitle} description={description} ogType={ogType}>
  <article class="article" data-pagefind-body data-pagefind-meta={`title:${title}`}>
    {(eyebrow || title) && (
      <header class="page-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <slot name="title">
          {title && <h1>{title}</h1>}
        </slot>
        <slot name="header-extras" />
      </header>
    )}
    <slot />
    {(author || updated) && (
      <Authorship author={author} updated={updated} editHref={editHref} />
    )}
  </article>
</Base>

<style>
  .article {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
    display: grid;
    gap: var(--s-7);
  }
  .page-head {
    display: grid;
    gap: var(--s-3);
  }
  .page-head h1 {
    font-size: clamp(34px, 5vw, 60px);
    font-variation-settings: 'opsz' 60;
    max-width: 22ch;
  }

  @media (max-width: 640px) {
    .article { padding: var(--s-6) var(--s-4); gap: var(--s-6); }
  }
</style>
