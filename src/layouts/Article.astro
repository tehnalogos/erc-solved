---
import Base from './Base.astro';
import Authorship from '~/components/primitives/Authorship.astro';

interface Props {
  title: string;
  summary?: string;
  seoTitle?: string;
  metaDescription?: string;
  h1?: string;
  ogTitle?: string;
  ogDescription?: string;
  about?: string[];
  /** @deprecated legacy call sites — pass `seoTitle` instead. */
  pageTitle?: string;
  /** @deprecated legacy call sites — pass `summary` instead. */
  description?: string;
  eyebrow?: string;
  author?: string;
  updated?: Date | string;
  editPath?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string | false;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  summary,
  seoTitle,
  metaDescription,
  h1,
  ogTitle,
  ogDescription,
  about,
  pageTitle,
  description,
  eyebrow,
  author,
  updated,
  editPath,
  canonical,
  ogType = 'article',
  ogImage,
  jsonLd,
} = Astro.props;

const editHref = editPath
  ? `https://github.com/tehnalogos/erc-solved/edit/main/${editPath}`
  : undefined;

const resolvedSeoTitle = seoTitle ?? pageTitle;
const visibleH1 = h1 ?? title;
---
<Base
  title={title}
  summary={summary}
  seoTitle={resolvedSeoTitle}
  metaDescription={metaDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  about={about}
  description={description}
  canonical={canonical}
  ogType={ogType}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="article" data-pagefind-body data-pagefind-meta={`title:${visibleH1}`}>
    {(eyebrow || visibleH1) && (
      <header class="page-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <slot name="title">
          {visibleH1 && <h1>{visibleH1}</h1>}
        </slot>
        <slot name="header-extras" />
      </header>
    )}
    <slot />
    {(author || updated) && (
      <Authorship author={author} updated={updated} editHref={editHref} />
    )}
  </article>
</Base>

<style>
  .article {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
    display: grid;
    gap: var(--s-7);
  }
  .page-head {
    display: grid;
    gap: var(--s-3);
  }
  .page-head h1 {
    font-size: clamp(34px, 5vw, 60px);
    font-variation-settings: 'opsz' 60;
    max-width: 22ch;
  }

  @media (max-width: 640px) {
    .article { padding: var(--s-6) var(--s-4); gap: var(--s-6); }
  }
</style>
