---
import Base from './Base.astro';
import Authorship from '~/components/primitives/Authorship.astro';
import StandardChip from '~/components/brand/StandardChip.astro';
import SpecBlock from '~/components/primitives/SpecBlock.astro';
import DiffArrow from '~/components/primitives/DiffArrow.astro';
import Verdict from '~/components/primitives/Verdict.astro';
import Crossref from '~/components/primitives/Crossref.astro';
import TOCRail from '~/components/primitives/TOCRail.astro';
import {
  techArticleJsonLd,
  breadcrumbJsonLd,
  faqPageJsonLd,
  personJsonLd,
  definedTermJsonLd,
  howToJsonLd,
  absoluteUrl,
  slugify,
} from '~/lib/seo';

interface Props { entry: any; }
const { entry } = Astro.props;
const { data, slug } = entry;
const path = `/${slug}/`;
const canonical = absoluteUrl(path);
const editHref = `https://github.com/tehnalogos/erc-solved/edit/main/src/content/erc/${slug}.mdx`;

const aboutTerms = [
  data.title,
  ...(data.aliases ?? []),
  'Ethereum',
  'EVM token standard',
  'LUKSO',
  'LSP standards',
  ...data.standardAuthors,
];

const keywords = [
  data.title,
  ...(data.aliases ?? []),
  `what is ${data.title}`,
  `${data.title} standard`,
  `${data.title} explained`,
  `${data.title} vs LSP-7`,
  ...data.standardAuthors,
];

const personLd = data.personSchema ? personJsonLd(data.personSchema) : null;

const faqsWithUrls = (data.faqs ?? []).map((f: any) => ({
  ...f,
  url: `${canonical}#faq-${slugify(f.q)}`,
}));

const jsonLd = [
  techArticleJsonLd({
    headline: data.pageTitle,
    description: data.description,
    path,
    updated: data.updated,
    author: data.author,
    about: aboutTerms,
    creator: personLd ?? undefined,
    mentions: data.mentions,
    keywords,
  }),
  breadcrumbJsonLd([
    { name: 'ERCs, Solved', path: '/' },
    { name: 'ERC Explainers', path: '/erc/' },
    { name: data.title, path },
  ]),
  ...(faqsWithUrls.length ? [faqPageJsonLd(faqsWithUrls)] : []),
  definedTermJsonLd({
    name: data.title,
    description: data.definition ?? data.description,
    url: canonical,
    inDefinedTermSet: 'https://eips.ethereum.org/',
    ...(data.termCode ? { termCode: data.termCode } : {}),
  }),
  ...(personLd ? [personLd] : []),
  ...(data.howToMigration
    ? [
        howToJsonLd({
          name: data.howToMigration.name,
          description: data.howToMigration.description,
          steps: data.howToMigration.steps,
          toolHref: data.howToMigration.toolHref,
        }),
      ]
    : []),
];

const headlineWords = data.headline.split(/\s+/);

// Reading-time from raw MDX body + structured content
const structuredWords = [
  data.definition ?? '',
  data.tldr ?? '',
  data.useErc ?? '',
  data.useLsp ?? '',
  ...((data.limits ?? []).map((l: any) => l.summary)),
  ...((data.faqs ?? []).map((f: any) => `${f.q} ${f.a}`)),
  ...((data.timeline ?? []).map((t: any) => t.text)),
  ...((data.glossary ?? []).map((g: any) => `${g.term} ${g.def}`)),
].join(' ');
const bodyText = `${entry.body ?? ''} ${structuredWords}`;
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 240));

const updatedStr = data.updated
  ? new Date(data.updated).toISOString().slice(0, 10)
  : null;

// Pivot framing — the "what LUKSO built instead" section. Defaults are
// honest for any ERC; entries can override (e.g. /erc-20/, where Vogelsteller
// IS the author of the ERC, gets a more personal "the author's second act"
// framing).
const pivot = {
  eyebrow: data.pivot?.eyebrow ?? 'the LUKSO alternative',
  headline: data.pivot?.headline ?? 'LUKSO designed it differently.',
  highlight: data.pivot?.highlight ?? 'LUKSO',
  tocLabel: data.pivot?.tocLabel ?? 'LUKSO alternative',
};
const pivotParts = pivot.headline.split(
  new RegExp(`(${pivot.highlight.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`),
);

const toc = [
  { depth: 2, text: `What is ${data.title}?`,   slug: 'what-is-erc-20' },
  { depth: 2, text: 'At a glance',              slug: 'at-a-glance' },
  { depth: 2, text: 'Origin story',             slug: 'origin' },
  { depth: 2, text: 'The spec',                 slug: 'the-spec' },
  { depth: 2, text: "What's broken",            slug: 'whats-broken' },
  ...((data.limits ?? []).map((l: any) => ({
    depth: 3,
    text: l.title.replace(/^The\s+/, '').replace(/\.$/, ''),
    slug: slugify(l.title),
  }))),
  { depth: 2, text: pivot.tocLabel,             slug: 'vogelsteller-pivot' },
  ...(data.compareRows?.length
    ? [{ depth: 2, text: `${data.title} vs LSP-7`, slug: 'compare' }]
    : []),
  { depth: 2, text: 'When to use which',        slug: 'when-to-use-which' },
  ...(data.faqs?.length
    ? [{ depth: 2, text: 'FAQ', slug: 'faq' }]
    : []),
  ...(data.primarySources?.length
    ? [{ depth: 2, text: 'Sources', slug: 'sources' }]
    : []),
  { depth: 2, text: 'Keep reading',             slug: 'keep-reading' },
];
---

<Base
  title={data.pageTitle}
  description={data.description}
  ogType="article"
  ogImage={data.ogImage}
  jsonLd={jsonLd}
>
  <article
    class="erc-page"
    data-pagefind-body
    data-pagefind-meta={`title:${data.title}`}
  >
    <section class="hero has-halo" id="what-is-erc-20">
      <div class="hero-inner">
        <span class="eyebrow">the standard · since {data.proposed}</span>

        <div class="boot" aria-label="status">
          <span class="typed">
            <span class="sigil">//</span>
            <span class="text"> {data.bootStrip}</span>
          </span>
          <span class="caret" aria-hidden="true">▍</span>
        </div>

        <h1 class="h1-stagger">
          {headlineWords.map((w: string, i: number) => (
            <>
              <span class="word" style={`--i:${i}`}>{w}</span>{' '}
            </>
          ))}
        </h1>

        <p class="tagline">{data.tagline}</p>

        <div class="chip-row">
          <StandardChip kind="erc" id={data.id} />
          {data.eipNumber && <span class="sep">·</span>}
          {data.eipNumber && <span class="eip">{data.eipNumber}</span>}
          <span class="sep">·</span>
          <span class="authors">by {data.standardAuthors.join(' + ')}</span>
        </div>

        {updatedStr && (
          <p class="meta-line">
            <span>updated <time datetime={updatedStr}>{updatedStr}</time></span>
            <span class="meta-sep">·</span>
            <span>{readingMinutes} min read</span>
            <span class="meta-sep">·</span>
            <span>by <a href="/about/">{data.author}</a></span>
          </p>
        )}

        {data.definition && (
          <aside class="definition" aria-label="Definition">
            <span class="def-label">definition</span>
            <p>{data.definition}</p>
          </aside>
        )}

        <div class="lede prose" data-reveal>
          <slot name="lede" />
        </div>

        <div class="cta-row" data-reveal>
          <a class="cta magnetic" href="#whats-broken">
            <span class="bracket">[</span>
            <span class="label">jump to what's broken</span>
            <span class="arrow">→</span>
            <span class="bracket">]</span>
          </a>
          {data.compareHref && (
            <span class="cta-meta">
              or read <a href={data.compareHref}>{data.title} vs LSP·7</a>
            </span>
          )}
        </div>
      </div>
    </section>

    {/* On-this-page disclosure — visible on narrow screens; sticky rail handles wide */}
    {toc.length > 0 && (
      <details class="toc-disclose">
        <summary>
          <span class="toc-key">on this page</span>
          <span class="toc-caret" aria-hidden="true">▾</span>
        </summary>
        <ol>
          {toc.map((i) => (
            <li class={`d-${i.depth}`}><a href={`#${i.slug}`}>{i.text}</a></li>
          ))}
        </ol>
      </details>
    )}

    {/* Sticky page-corner TOC — only visible at >=1280px */}
    {toc.length > 0 && (
      <div class="toc-fixed" aria-hidden="false">
        <TOCRail items={toc} />
      </div>
    )}

    {data.stats?.length > 0 && (
      <section class="band stats-band" id="at-a-glance">
        <div class="band-inner">
          <span class="eyebrow">at a glance</span>
          <h2>The standard, in one card.</h2>
          <dl class="stats">
            {data.stats.map((s: any) => (
              <div class="stat">
                <dt>{s.k}</dt>
                <dd>
                  {s.href
                    ? <a href={s.href} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>{s.v}</a>
                    : s.v}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <section class="band tldr-band">
      <div class="band-inner">
        <Verdict tone="use-lsp" label="tl;dr">
          <p>{data.tldr}</p>
        </Verdict>
      </div>
    </section>

    <section class="band" id="origin">
      <div class="band-inner">
        <span class="eyebrow">how the standard came to be</span>
        <h2>The origin story.<a class="anchor" href="#origin" aria-label="Link to this section">#</a></h2>
        <div class="prose">
          <slot name="origin" />
        </div>

        {data.timeline?.length > 0 && (
          <ol class="timeline" data-reveal>
            {data.timeline.map((t: any) => (
              <li class="tl-row">
                <span class="tl-year">{t.year}</span>
                <span class="tl-rule" aria-hidden="true"></span>
                <span class="tl-text">
                  {t.text}{' '}
                  {t.href && (
                    <a class="tl-cite" href={t.href} rel={t.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={t.href.startsWith('http') ? '_blank' : undefined}>↗</a>
                  )}
                </span>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>

    <section class="band" id="the-spec">
      <div class="band-inner">
        <span class="eyebrow">the spec, end to end</span>
        <h2>What {data.title} actually is.<a class="anchor" href="#the-spec" aria-label="Link to this section">#</a></h2>
        <SpecBlock chip={data.title} chipKind="erc" caption={`${data.eipNumber ?? data.title} interface`} lang="solidity">{data.abi}</SpecBlock>

        {data.interfaceDiagram?.length > 0 && (
          <figure class="iface" aria-label={`${data.title} interface, grouped`}>
            <figcaption>
              <span class="if-chip">{data.title}</span>
              <span class="if-caption">interface, grouped</span>
            </figcaption>
            <div class="if-body">
              {data.interfaceDiagram.map((g: any) => (
                <div class="if-row">
                  <span class="if-group">{g.group}:</span>
                  <span class="if-items">
                    {g.items.map((it: string, i: number) => (
                      <>
                        {i > 0 && <span class="if-sep"> · </span>}
                        <code>{it}</code>
                      </>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          </figure>
        )}

        <div class="prose">
          <slot name="spec" />
        </div>
      </div>
    </section>

    <section class="band" id="whats-broken">
      <div class="band-inner">
        <span class="eyebrow">the integration tax</span>
        <h2>What's broken about {data.title}.<a class="anchor" href="#whats-broken" aria-label="Link to this section">#</a></h2>
        <div class="prose lede-prose">
          <slot name="whatsBroken" />
        </div>

        <ol class="limits">
          {data.limits.map((lim: any, i: number) => {
            const limSlug = slugify(lim.title);
            return (
              <li class="limit" data-reveal id={limSlug}>
                <div class="limit-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
                <div class="limit-body">
                  <h3>{lim.title}<a class="anchor" href={`#${limSlug}`} aria-label="Link to this section">#</a></h3>
                  <p>{lim.summary}</p>
                  <DiffArrow size="md" framed from={lim.from} to={lim.to} />
                  {lim.workarounds.length > 0 && (
                    <p class="workarounds">
                      <span class="wk-label">workarounds tried:</span>{' '}
                      {lim.workarounds.map((w: string, idx: number) => (
                        <>
                          {idx > 0 && <span class="wk-sep"> · </span>}
                          <span class="wk-item">{w}</span>
                        </>
                      ))}
                    </p>
                  )}
                  {lim.href && (
                    <p class="deeper"><Crossref href={lim.href}>read the deep-dive</Crossref></p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section class="band" id="vogelsteller-pivot">
      <div class="band-inner">
        <span class="eyebrow">{pivot.eyebrow}</span>
        <h2>{pivotParts.map((part: string) => (
          part === pivot.highlight
            ? <span class="pink">{part}</span>
            : part
        ))}<a class="anchor" href="#vogelsteller-pivot" aria-label="Link to this section">#</a></h2>
        <div class="prose">
          <slot name="vogelsteller" />
        </div>

        <ul class="routes" data-reveal>
          {data.luksoRoutes.map((r: any) => (
            <li>
              <a class="route" href={r.href}>
                <span class="route-chip">{r.chip}</span>
                <span class="route-label">{r.label}</span>
                <span class="route-summary">{r.summary}</span>
                <span class="route-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {data.compareRows.length > 0 && (
      <section class="band" id="compare">
        <div class="band-inner">
          <span class="eyebrow">spec to spec, at a glance</span>
          <h2>{data.title} vs LSP·7 in one table.<a class="anchor" href="#compare" aria-label="Link to this section">#</a></h2>
          <div class="compare-wrap" data-reveal>
            <table class="compare">
              <thead>
                <tr>
                  <th class="row-label">row</th>
                  <th class="left"><StandardChip kind="erc" id={data.id} /></th>
                  <th class="right"><StandardChip kind="lsp" id="7" /></th>
                </tr>
              </thead>
              <tbody>
                {data.compareRows.map((r: any) => (
                  <tr>
                    <td class="row-label">{r.row}</td>
                    <td class="left"><code>{r.left}</code></td>
                    <td class="right"><code>{r.right}</code></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {data.compareHref && (
            <p class="compare-foot">
              full matrix → <Crossref href={data.compareHref}>standards/compare/erc20-lsp7</Crossref>
            </p>
          )}
        </div>
      </section>
    )}

    <section class="band" id="when-to-use-which">
      <div class="band-inner">
        <span class="eyebrow">be honest about scope</span>
        <h2>When to use which.<a class="anchor" href="#when-to-use-which" aria-label="Link to this section">#</a></h2>
        <div class="verdict-pair">
          <Verdict tone="use-erc" label={`use ${data.title} when`}>
            <p>{data.useErc}</p>
          </Verdict>
          <Verdict tone="use-lsp" label="reach for LSP when">
            <p>{data.useLsp}</p>
          </Verdict>
        </div>
      </div>
    </section>

    {data.faqs.length > 0 && (
      <section class="band" id="faq">
        <div class="band-inner">
          <span class="eyebrow">people also ask</span>
          <h2>FAQ.<a class="anchor" href="#faq" aria-label="Link to this section">#</a></h2>
          <ul class="faqs">
            {data.faqs.map((f: any, i: number) => {
              const faqId = `faq-${slugify(f.q)}`;
              return (
                <li class="faq" id={faqId}>
                  <span class="faq-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div class="faq-body">
                    <h3 class="faq-q">
                      {f.q}
                      <a class="anchor" href={`#${faqId}`} aria-label="Link to this question">#</a>
                    </h3>
                    <p class="faq-a">{f.a}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    {data.glossary?.length > 0 && (
      <section class="band glossary-band" id="glossary">
        <div class="band-inner">
          <details class="glossary-disclose">
            <summary>
              <span class="eyebrow">glossary</span>
              <span class="gloss-key">{data.glossary.length} terms used on this page</span>
              <span class="gloss-caret" aria-hidden="true">▾</span>
            </summary>
            <dl class="glossary">
              {data.glossary.map((g: any) => (
                <div class="gloss-row">
                  <dt>{g.term}</dt>
                  <dd>{g.def}</dd>
                </div>
              ))}
            </dl>
          </details>
        </div>
      </section>
    )}

    {data.primarySources?.length > 0 && (
      <section class="band sources-band" id="sources">
        <div class="band-inner">
          <span class="eyebrow">primary sources</span>
          <h2>Where this page draws from.<a class="anchor" href="#sources" aria-label="Link to this section">#</a></h2>
          <ol class="sources">
            {data.primarySources.map((s: any) => (
              <li>
                <Crossref href={s.href}>{s.label}</Crossref>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <section class="band" id="keep-reading">
      <div class="band-inner">
        <span class="eyebrow">where to go next</span>
        <h2>Keep reading.<a class="anchor" href="#keep-reading" aria-label="Link to this section">#</a></h2>
        <ul class="next-list">
          {data.luksoRoutes.map((r: any) => (
            <li>
              <a class="next-row" href={r.href}>
                <span class="next-q">{r.label.toLowerCase()}</span>
                <span class="next-arrow" aria-hidden="true">→</span>
                <span class="next-a">{r.chip}</span>
              </a>
            </li>
          ))}
          {data.compareHref && (
            <li>
              <a class="next-row" href={data.compareHref}>
                <span class="next-q">{data.title.toLowerCase()} vs lsp-7 (full matrix)</span>
                <span class="next-arrow" aria-hidden="true">→</span>
                <span class="next-a">comparison</span>
              </a>
            </li>
          )}
          <li>
            <a class="next-row" href="/standards/matrix/">
              <span class="next-q">all ERC ↔ LSP mappings</span>
              <span class="next-arrow" aria-hidden="true">→</span>
              <span class="next-a">matrix</span>
            </a>
          </li>
          <li>
            <a class="next-row" href="/problems/">
              <span class="next-q">start from your problem</span>
              <span class="next-arrow" aria-hidden="true">→</span>
              <span class="next-a">problems</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <div class="authorship-wrap">
      <Authorship author={data.author} updated={data.updated} editHref={editHref} />
    </div>
  </article>

  <script>
    // Cursor-tracking halo for this page's hero
    const hero = document.querySelector<HTMLElement>('.erc-page .hero.has-halo');
    if (hero) {
      let raf = 0;
      let nextX = 50, nextY = 30;
      const apply = () => {
        hero.style.setProperty('--cx', `${nextX}%`);
        hero.style.setProperty('--cy', `${nextY}%`);
        raf = 0;
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        nextX = ((e.clientX - r.left) / r.width) * 100;
        nextY = ((e.clientY - r.top) / r.height) * 100;
        hero.dataset.halo = 'on';
        if (!raf) raf = requestAnimationFrame(apply);
      });
      hero.addEventListener('pointerleave', () => { hero.dataset.halo = ''; });
    }

    // Magnetic CTA
    document.querySelectorAll<HTMLElement>('.erc-page .magnetic').forEach((el) => {
      const PULL = 0.22;
      const RANGE = 90;
      let raf = 0;
      const apply = (dx: number, dy: number) => {
        el.style.setProperty('--mx', `${dx}px`);
        el.style.setProperty('--my', `${dy}px`);
        raf = 0;
      };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > RANGE) return;
        el.dataset.magnetize = 'on';
        if (!raf) raf = requestAnimationFrame(() => apply(dx * PULL, dy * PULL));
      });
      el.addEventListener('pointerleave', () => {
        el.dataset.magnetize = '';
        el.style.setProperty('--mx', '0px');
        el.style.setProperty('--my', '0px');
      });
    });
  </script>
</Base>

<style>
  .erc-page {
    display: grid;
  }

  /* ── hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding: var(--s-8) var(--s-5) var(--s-7);
    overflow: hidden;
    border-bottom: 1px solid var(--ink-line);
  }
  .hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--s-5);
    position: relative;
    min-width: 0;
  }
  .hero-inner > * { min-width: 0; max-width: 100%; }
  .boot { max-width: 100%; overflow: hidden; }

  .hero h1 {
    max-width: 18ch;
    font-size: clamp(48px, 9vw, 120px);
    font-variation-settings: 'opsz' 88;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero h1 .word { margin-right: 0; }

  .tagline {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 36;
    font-size: clamp(22px, 3vw, 36px);
    color: var(--ink-bone-dim);
    line-height: 1.2;
    max-width: 32ch;
  }

  .chip-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--t-mono-xs);
    color: var(--ink-fog);
  }
  .chip-row .sep { color: var(--ink-line); }
  .chip-row .eip { color: var(--erc-sand); }
  .chip-row .authors { color: var(--ink-bone-dim); }

  .lede {
    max-width: 72ch;
  }
  .lede :global(p) {
    font-size: var(--t-mono-md);
