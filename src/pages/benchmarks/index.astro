---
import { getCollection } from 'astro:content';
import Article from '~/layouts/Article.astro';
import Crossref from '~/components/primitives/Crossref.astro';

const entries = (await getCollection('benchmarks')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const displayTitle = 'Consumer Blockchain Benchmarks';
const seoTitle = 'Consumer blockchain benchmarks: cited and reproducible';
const metaDescription =
  'Open benchmarks of consumer-app architecture across Ethereum, Base, Arbitrum, Optimism, Polygon, Solana, LUKSO. Every value cites the chain docs. CC-BY-4.0.';
const ogTitle = "Every benchmark value on this site cites the chain doc it came from";
const ogDescription =
  'No trust-me numbers. Every consumer-blockchain benchmark ships a CSV, a JSON, and a per-metric derivation block that names the source. Licensed CC-BY-4.0 for citation.';
const summary =
  'Open benchmarks of consumer-app architecture across Ethereum L1, Base, Arbitrum, Optimism, Polygon, Solana, and LUKSO. Every value cites the chain documentation it was derived from.';
const aboutTopics = [
  'Blockchain benchmarks',
  'Consumer crypto architecture',
  'Open datasets',
  'Ethereum benchmark',
  'Solana benchmark',
  'LUKSO benchmark',
  'CC-BY-4.0',
];
---
<Article
  title={displayTitle}
  summary={summary}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  about={aboutTopics}
  eyebrow="benchmarks · open research"
  author="ercs-solved maintainers"
  updated="2026-06-29"
  editPath="src/pages/benchmarks/index.astro"
>
  <p class="lede">{summary}</p>
  <p class="lede">
    Every benchmark publishes a readable report, downloadable CSV + JSON datasets, and a
    designated per-metric derivation section that cites the chain documentation each value
    came from. The data is licensed CC-BY-4.0 for citation.
  </p>
  <ul class="list">
    {entries.map((e) => (
      <li>
        <a class="row" href={`/benchmarks/${e.slug}/`}>
          <span class="title">{e.data.title}</span>
          <span class="lastrun">last run · {new Date(e.data.lastRun).toISOString().slice(0,10)}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <section class="more">
    <h2>Methodology.</h2>
    <p>The scoring rubric, criteria framework, and reproducibility requirements behind every benchmark are documented in <Crossref href="/research/methodology/">the research methodology</Crossref>.</p>
  </section>
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; }
  .list { display: grid; border-top: 1px solid var(--ink-line); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
  }
  .row:hover { background: var(--ink-paper); }
  .title { color: var(--ink-bone); font-size: var(--t-mono-md); }
  .lastrun { color: var(--signal-pink); font-size: var(--t-mono-xs); text-transform: lowercase; }
  .arrow { color: var(--ink-fog); }
  .row:hover .arrow { color: var(--signal-pink); }
  .more {
    display: grid; gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .more h2 { font-size: var(--t-serif-1); }
  .more p { color: var(--ink-bone-dim); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; }
    .lastrun { grid-column: 1 / -1; }
  }
</style>
