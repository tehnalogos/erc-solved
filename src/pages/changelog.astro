---
import Base from '~/layouts/Base.astro';
import Authorship from '~/components/primitives/Authorship.astro';

interface Entry { date: string; title: string; body: string; tags?: string[] }
const entries: Entry[] = [
  {
    date: '2026-06-23',
    title: 'LUKSO pink replaces the cyan accent.',
    tags: ['brand'],
    body: 'Swapped the electric-cyan signal color (#00E5FF) for LUKSO brand pink (#FE005B). The LSP side of every diff, every interaction state, every hover. The warning amber for ERC stays.',
  },
  {
    date: '2026-06-22',
    title: 'LUKSO portability framing corrected across all content.',
    tags: ['content'],
    body: 'Earlier copy implied LSPs were "LUKSO-native and not portable to mainnet." That is wrong — LUKSO is an EVM L1, LSPs are plain EVM smart contracts deployable on any EVM chain. Rewrote the honest tradeoff: the standards travel, but the ecosystem (wallets, indexers, marketplaces) that makes them useful was designed around them on LUKSO.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 6 — sitemap, changelog, RSS.',
    tags: ['polish', 'seo'],
    body: 'Sitemap re-enabled with all routes. robots.txt points at /sitemap-index.xml. /changelog/ shipped. RSS at /changelog.xml.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 5 — ⌘K search and smart 404.',
    tags: ['search', '404'],
    body: 'Pagefind indexes every problem, standard, comparison, migration, and build vertical at build time. Triggered by ⌘K, Ctrl+K, or /. Empty state shows the top 6 queries and the 6 build verticals. 404 auto-opens search.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 4 — Build verticals and migration guides.',
    tags: ['content'],
    body: '/build/ shipped with 6 verticals (token economics, dynamic NFTs, smart wallet UX, gasless onboarding, profile-native apps, extending deployed contracts). 4 migration guides under /build/migrate/.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 3 — Standards, the matrix, and 6 comparisons.',
    tags: ['content'],
    body: '/standards/ shipped with 15 explainers covering LSP0–LSP26 + ERC725. /standards/matrix/ is the canonical decision page — 15 rows mapping every relevant ERC to its LSP equivalent. 6 spec-grade comparison pages under /standards/compare/.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 2 — Problem hub and 12 problem pages.',
    tags: ['content'],
    body: '/problems/ is a flat, filterable index of 12 problem pages. Filter chips per ERC. Each problem page opens with the chip-to-chip transformation, a verdict, and the LSP move.',
  },
  {
    date: '2026-06-22',
    title: 'Phase 1 — Brand reset and Astro scaffold.',
    tags: ['brand'],
    body: 'New visual identity: Fraunces display serif + JetBrains Mono body, off-black canvas, LUKSO pink + warning amber. Retired the starfield, scanline, and ship-console. New thesis: ERCs are interfaces. LSPs are the system.',
  },
];

const description =
  'Every meaningful change to ERCs, Solved. Run-of-record for the maintainers and a recap for returning readers.';
---
<Base title="Changelog" description={description}>
  <section class="page">
    <header class="head">
      <span class="eyebrow">changelog · run of record</span>
      <h1>Changelog.</h1>
      <p class="dim">
        Every meaningful change. The
        <a href="/changelog.xml" rel="alternate" type="application/rss+xml">RSS feed</a>
        is at <code>/changelog.xml</code>.
      </p>
    </header>

    <ol class="entries">
      {entries.map(e => (
        <li>
          <article class="entry">
            <header class="entry-head">
              <time datetime={e.date}>{e.date}</time>
              {e.tags && (
                <ul class="tags">
                  {e.tags.map(t => <li>{t}</li>)}
                </ul>
              )}
            </header>
            <h2>{e.title}</h2>
            <p>{e.body}</p>
          </article>
        </li>
      ))}
    </ol>

    <Authorship
      author="ercs-solved maintainers"
      updated="2026-06-22"
      editHref="https://github.com/lukso-network/ercs-solved/edit/main/src/pages/changelog.astro"
    />
  </section>
</Base>

<style>
  .page { max-width: var(--container); margin: 0 auto; padding: var(--s-8) var(--s-5); display: grid; gap: var(--s-7); }
  .head { display: grid; gap: var(--s-3); max-width: 64ch; }
  .head h1 { font-size: clamp(40px, 6vw, 80px); }
  .head .dim { color: var(--ink-bone-dim); }
  .head a { color: var(--ink-bone); border-bottom: 1px solid var(--ink-line); }
  .head a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }
  .head code { background: var(--ink-paper); border: 1px solid var(--ink-line); padding: 0 4px; color: var(--signal-pink); font-size: 0.95em; }

  .entries { display: grid; gap: 0; border-top: 1px solid var(--ink-line); }
  .entries li { border-bottom: 1px solid var(--ink-line); padding: var(--s-5) 0; }

  .entry { display: grid; gap: var(--s-3); }
  .entry-head { display: flex; gap: var(--s-3); align-items: baseline; flex-wrap: wrap; font-family: var(--font-mono); font-size: var(--t-mono-sm); }
  .entry-head time { color: var(--signal-pink); font-variant-numeric: tabular-nums; }
  .tags { display: flex; gap: var(--s-2); }
  .tags li {
    padding: 1px var(--s-2);
    border: 1px solid var(--ink-line);
    color: var(--ink-fog);
    font-size: var(--t-mono-xs);
    text-transform: lowercase;
  }
  .entry h2 { font-size: clamp(22px, 2.4vw, 28px); font-variation-settings: 'opsz' 36; max-width: 32ch; }
  .entry p { color: var(--ink-bone-dim); max-width: 68ch; }
</style>
