---
import Base from '~/layouts/Base.astro';
import DiffArrow from '~/components/primitives/DiffArrow.astro';
import Authorship from '~/components/primitives/Authorship.astro';

const description =
  'A spec-grade field guide for Ethereum and EVM builders. Ethereum Request for Comments (ERC) pain points mapped to the LUKSO LSP standards that were designed instead of layered.';

const verticals = [
  { label: 'Token economics',         stack: 'LSP7 + LSP4',                href: '/build/token-economics/' },
  { label: 'Dynamic NFTs',            stack: 'LSP8 + LSP4 + ERC-725Y',     href: '/build/dynamic-nfts/' },
  { label: 'Smart wallet UX',         stack: 'LSP0 + LSP6',                href: '/build/smart-wallet-ux/' },
  { label: 'Gasless onboarding',      stack: 'LSP25 + LSP6',               href: '/build/gasless-onboarding/' },
  { label: 'Profile-native apps',     stack: 'LSP0 + LSP3 + LSP26',       href: '/build/profile-native-apps/' },
  { label: 'Extending deployed code', stack: 'LSP17 (+ LSP14)',            href: '/build/extending-deployed-contracts/' },
];

const commonPainPoints = [
  { q: 'erc20 approval risks',          a: 'LSP7 + LSP6',           href: '/problems/erc20-approval-risks/' },
  { q: 'erc721 dynamic metadata',       a: 'LSP8 + LSP4 + ERC-725Y', href: '/problems/erc721-dynamic-metadata/' },
  { q: 'erc-4337 alternatives',         a: 'LSP0 + LSP6 + LSP25',   href: '/problems/erc4337-bundler-tax/' },
  { q: 'erc20 transfer hooks',          a: 'LSP7 + LSP1',            href: '/problems/erc20-transfer-hooks/' },
  { q: 'social recovery smart wallets', a: 'LSP6 controllers',        href: '/problems/social-recovery/' },
  { q: 'safetransferfrom problems',     a: 'LSP1 universal receiver', href: '/problems/erc721-safe-transfer/' },
];
---

<Base
  title="Ethereum ERC Problems and LUKSO LSP Solutions"
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Ethereum ERC Problems and LUKSO LSP Solutions',
    description,
    url: 'https://www.ercsolved.dev/',
    about: [
      'Ethereum Request for Comments',
      'ERC standards',
      'LUKSO LSP standards',
      'EVM builder guidance',
    ],
  }}
>
  <section class="hero has-halo" data-pagefind-body data-pagefind-meta="title:Ethereum ERC Problems and LUKSO LSP Solutions">
    <div class="hero-inner">
      <div class="boot" aria-label="status">
        <span class="typed">
          <span class="sigil">//</span>
          <span class="long">field manual · 12 problems · 15 standards · ready</span>
          <span class="short">field manual · ready</span>
        </span>
        <span class="caret" aria-hidden="true">▍</span>
      </div>

      <h1 class="h1-stagger">
        <span class="word" style="--i:0">ERCs</span>
        <span class="word" style="--i:1">are</span>
        <span class="word" style="--i:2">interfaces.</span>
        <span class="break"></span>
        <span class="word dim" style="--i:3">LSPs</span>
        <span class="word dim" style="--i:4">are</span>
        <span class="word dim" style="--i:5">the</span>
        <span class="word dim" style="--i:6">system.</span>
      </h1>

      <p class="lede" data-reveal>
        ERC-20, ERC-721, and ERC-1155 won by underspecifying. Every team since has paid the
        integration
        tax — approval phishing, NFTs stranded in vaults, tokenURI servers offline, EOAs you
        can't recover, ERC-4337 stacks bolted on to fake what an account should be. This is the
        reference for the standards that were designed instead of layered.
      </p>
      <div class="cta-row" data-reveal>
        <a class="cta magnetic" href="/problems/">
          <span class="bracket">[</span>
          <span class="label">start with your problem</span>
          <span class="arrow">→</span>
          <span class="bracket">]</span>
        </a>
        <span class="cta-meta">or browse <a href="/standards/matrix/">the ERC ↔ LSP matrix</a></span>
      </div>
    </div>
  </section>

  <script>
    // Hero halo — pink radial gradient that follows the cursor.
    const hero = document.querySelector<HTMLElement>('.hero.has-halo');
    if (hero) {
      let raf = 0;
      let nextX = 50, nextY = 30;
      const apply = () => {
        hero.style.setProperty('--cx', `${nextX}%`);
        hero.style.setProperty('--cy', `${nextY}%`);
        raf = 0;
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        nextX = ((e.clientX - r.left) / r.width) * 100;
        nextY = ((e.clientY - r.top) / r.height) * 100;
        hero.dataset.halo = 'on';
        if (!raf) raf = requestAnimationFrame(apply);
      });
      hero.addEventListener('pointerleave', () => { hero.dataset.halo = ''; });
    }

    // Magnetic CTA — gentle pull toward the cursor when close.
    document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
      const PULL = 0.22;       // % of distance from center
      const RANGE = 90;        // px radius where magnetism kicks in
      let raf = 0;
      const apply = (dx: number, dy: number) => {
        el.style.setProperty('--mx', `${dx}px`);
        el.style.setProperty('--my', `${dy}px`);
        raf = 0;
      };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > RANGE) return;
        el.dataset.magnetize = 'on';
        if (!raf) raf = requestAnimationFrame(() => apply(dx * PULL, dy * PULL));
      });
      el.addEventListener('pointerleave', () => {
        el.dataset.magnetize = '';
        el.style.setProperty('--mx', '0px');
        el.style.setProperty('--my', '0px');
      });
    });
  </script>

  <section class="example">
    <div class="example-inner">
      <div class="example-head">
        <span class="eyebrow">the pattern, in one example</span>
        <h2 class="example-title">The approval problem, <span class="solved">solved.</span></h2>
        <p class="dim">
          A signature comparison. The <span class="amber">−</span> line is the ERC surface you
          inherit. The <span class="pink">+</span> line is the LSP design you can build around.
        </p>
      </div>
      <div data-reveal>
        <DiffArrow
          size="lg"
          framed
          animated
          from={{
            chip: 'ERC-20',
            code: 'approve(spender, amount)',
            tags: ['unbounded', 'phishable', 'split-intent'],
          }}
          to={{
            chip: 'LSP7',
            code: 'authorizeOperator(op, amount, data)',
            tags: ['scoped', 'revocable', 'LSP6 account permissions'],
          }}
        />
      </div>
      <p class="example-foot dim">
        Read the full page →
        <a href="/problems/erc20-approval-risks/">erc20 approval risks</a>
      </p>
    </div>
  </section>

  <section class="band verticals" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">what are you building?</span>
        <h2>Pick a vertical. Get a reading list.</h2>
      </div>
      <ul class="vert-grid">
        {verticals.map(v => (
          <li>
            <a class="vert" href={v.href}>
              <span class="vert-label">{v.label}</span>
              <span class="vert-stack">{v.stack}</span>
              <span class="vert-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band queries" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">common ERC pain points</span>
        <h2>Start where your ERC design is breaking down.</h2>
      </div>
      <ul class="query-list">
        {commonPainPoints.map(({ q, a, href }) => (
          <li>
            <a class="query-row" href={href}>
              <span class="q">{q}</span>
              <span class="arrow" aria-hidden="true">→</span>
              <span class="a">{a}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="footnote">
    <div class="footnote-inner">
      <Authorship
        author="ercs-solved maintainers"
        updated="2026-06-22"
        editHref="https://github.com/tehnalogos/erc-solved/edit/main/src/pages/index.astro"
      />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--s-8) var(--s-5) var(--s-6);
    overflow: hidden;
  }
  .hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--s-5);
    position: relative;
    min-width: 0;
  }
  /* Prevent any wide child (e.g. the boot strip with nowrap) from
     blowing up the grid past viewport width — would clip everything. */
  .hero-inner > * { min-width: 0; max-width: 100%; }
  .boot { max-width: 100%; overflow: hidden; }

  h1 {
    max-width: 22ch;
    font-size: clamp(36px, 5.5vw, 68px);
    font-variation-settings: 'opsz' 60;
    line-height: 1.04;
  }
  h1 .word { margin-right: 0.22em; }
  h1 .word.dim { color: var(--ink-bone-dim); }
  h1 .break { display: block; height: 0; }
  h1 .dim { color: var(--ink-bone-dim); }

  .lede {
    max-width: 72ch;
    font-size: var(--t-mono-md);
    color: var(--ink-bone-dim);
  }

  .cta-row {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: var(--s-3);
  }
  .cta {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--ink-bone);
    color: var(--ink-bone);
    font-family: var(--font-mono);
    font-size: var(--t-mono-md);
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .cta:hover, .cta:focus-visible {
    background: var(--signal-pink);
    color: var(--ink-black);
    border-color: var(--signal-pink);
    outline: none;
  }
  .cta .bracket { color: var(--ink-fog); }
  .cta:hover .bracket { color: var(--ink-black); }
  .cta-meta { font-size: var(--t-mono-sm); color: var(--ink-fog); }
  .cta-meta a {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .cta-meta a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }

  .example {
    padding: var(--s-7) var(--s-5) var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .example-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--s-5);
  }
  .example-head { display: grid; gap: var(--s-3); }
  .example-title {
    font-size: clamp(28px, 3.5vw, 44px);
    max-width: 18ch;
  }
  .example-title .solved { color: var(--signal-pink); }
  .example-head p { max-width: 64ch; }
  .amber { color: var(--erc-sand); font-family: var(--font-mono); }
  .pink  { color: var(--signal-pink); font-family: var(--font-mono); }

  .example-foot { font-size: var(--t-mono-sm); }
  .example-foot a {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .example-foot a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }

  .band { padding: var(--s-9) var(--s-5); border-top: 1px solid var(--ink-line); }
  .band-inner { max-width: var(--container); margin: 0 auto; display: grid; gap: var(--s-6); }
  .band-head { display: grid; gap: var(--s-3); }
  .band-head h2 { font-size: clamp(28px, 3.5vw, 44px); }

  .vert-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink-line);
    border-left: 1px solid var(--ink-line);
  }
  .vert {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: baseline;
    column-gap: var(--s-3);
    padding: var(--s-5);
    border-right: 1px solid var(--ink-line);
    border-bottom: 1px solid var(--ink-line);
    transition: background 150ms ease;
  }
  .vert:hover, .vert:focus-visible { background: var(--ink-paper); outline: none; }
  .vert-label {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 36;
    font-size: 22px;
    color: var(--ink-bone);
    line-height: 1.15;
  }
  .vert-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-fog);
    font-size: 20px;
  }
  .vert:hover .vert-arrow { color: var(--signal-pink); }
  .vert-stack {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--signal-pink);
    margin-top: var(--s-2);
  }

  .query-list {
    display: grid;
    border-top: 1px solid var(--ink-line);
  }
  .query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-2);
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
  }
  .query-row .q { color: var(--erc-sand); font-size: var(--t-mono-md); }
  .query-row .arrow { color: var(--ink-line); }
  .query-row .a { color: var(--signal-pink); font-size: var(--t-mono-md); }
  .query-row:hover { background: var(--ink-paper); }
  .query-row:hover .arrow { color: var(--ink-bone); }

  .footnote { padding: 0 var(--s-5); }
  .footnote-inner { max-width: var(--container); margin: 0 auto; }

  @media (max-width: 900px) {
    .vert-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: var(--s-7) var(--s-4) var(--s-5); }
    .example { padding: var(--s-6) var(--s-4) var(--s-7); }
    .band { padding: var(--s-7) var(--s-4); }
    .query-row { grid-template-columns: 1fr; gap: var(--s-1); padding: var(--s-3) 0; }
    .query-row .arrow { display: none; }
  }
</style>
