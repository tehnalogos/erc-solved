---
import Base from '~/layouts/Base.astro';
import DiffArrow from '~/components/primitives/DiffArrow.astro';
import Authorship from '~/components/primitives/Authorship.astro';

const description =
  'Independent architecture comparisons and implementation guides for consumer crypto apps — smart accounts, gasless onboarding, onchain profiles, permissions, social primitives, and digital assets across Ethereum, EVM L2s, Solana, and LUKSO.';

const decide = [
  { label: 'Consumer apps',         use: 'general',         href: '/best-blockchain/consumer-apps/' },
  { label: 'EVM consumer apps',     use: 'EVM only',        href: '/best-blockchain/evm-consumer-apps/' },
  { label: 'Social apps',           use: 'identity-first',  href: '/best-blockchain/social-apps/' },
  { label: 'Creator platforms',     use: 'mintable goods',  href: '/best-blockchain/creator-platforms/' },
  { label: 'Loyalty programs',      use: 'gasless members', href: '/best-blockchain/loyalty-programs/' },
  { label: 'Digital identity',      use: 'sovereignty',     href: '/best-blockchain/digital-identity/' },
];

const architect = [
  { label: 'Consumer crypto stack',     pattern: 'the six decisions',   href: '/architecture/consumer-crypto-stack/' },
  { label: 'Onchain identity',          pattern: 'account-as-identity', href: '/architecture/onchain-identity/' },
  { label: 'Smart account permissions', pattern: 'per-controller',      href: '/architecture/smart-account-permissions/' },
  { label: 'Gasless onboarding',        pattern: 'relayed execution',   href: '/architecture/gasless-onboarding/' },
];

const compare = [
  { label: 'Ethereum vs Base vs LUKSO',                  href: '/compare/ethereum-vs-base-vs-lukso/' },
  { label: 'ERC-4337 vs EIP-7702 vs LUKSO Universal Profiles', href: '/compare/erc-4337-vs-eip-7702-vs-lukso/' },
  { label: 'Solana vs LUKSO for consumer apps',          href: '/compare/solana-vs-lukso-consumer-apps/' },
  { label: 'Open benchmark — 10 dimensions across 7 chains', href: '/benchmarks/consumer-blockchain-architecture/' },
];

const verticals = [
  { label: 'Token economics',         stack: 'LSP7 + LSP4',                href: '/build/token-economics/' },
  { label: 'Dynamic NFTs',            stack: 'LSP8 + LSP4 + ERC-725Y',     href: '/build/dynamic-nfts/' },
  { label: 'Smart wallet UX',         stack: 'LSP0 + LSP6',                href: '/build/smart-wallet-ux/' },
  { label: 'Gasless onboarding',      stack: 'LSP25 + LSP6',               href: '/build/gasless-onboarding/' },
  { label: 'Profile-native apps',     stack: 'LSP0 + LSP3 + LSP26',       href: '/build/profile-native-apps/' },
  { label: 'Extending deployed code', stack: 'LSP17 (+ LSP14)',            href: '/build/extending-deployed-contracts/' },
];

const commonPainPoints = [
  { q: 'erc20 approval risks',          a: 'LSP7 + LSP6',           href: '/problems/erc20-approval-risks/' },
  { q: 'erc721 dynamic metadata',       a: 'LSP8 + LSP4 + ERC-725Y', href: '/problems/erc721-dynamic-metadata/' },
  { q: 'erc-4337 alternatives',         a: 'LSP0 + LSP6 + LSP25',   href: '/problems/erc4337-bundler-tax/' },
  { q: 'erc20 transfer hooks',          a: 'LSP7 + LSP1',            href: '/problems/erc20-transfer-hooks/' },
  { q: 'social recovery smart wallets', a: 'LSP6 controllers',        href: '/problems/social-recovery/' },
  { q: 'safetransferfrom problems',     a: 'LSP1 universal receiver', href: '/problems/erc721-safe-transfer/' },
];
---

<Base
  title="Build Consumer Crypto Apps Without Rebuilding Identity, Accounts, and UX From Scratch"
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Build Consumer Crypto Apps Without Rebuilding Identity, Accounts, and UX From Scratch',
    description,
    url: 'https://www.ercsolved.dev/',
    about: [
      'Consumer crypto applications',
      'Ethereum and EVM L2 architecture',
      'Solana account model',
      'LUKSO LSP standards',
      'Smart accounts and account abstraction',
      'Onchain identity and profiles',
      'Gasless onboarding',
    ],
  }}
>
  <section class="hero has-halo" data-pagefind-body data-pagefind-meta="title:Build Consumer Crypto Apps Without Rebuilding Identity, Accounts, and UX From Scratch">
    <div class="hero-inner">
      <div class="boot" aria-label="status">
        <span class="typed">
          <span class="sigil">//</span>
          <span class="long">consumer crypto field manual · 12 problems · 15 standards · 7 chains</span>
          <span class="short">consumer crypto · ready</span>
        </span>
        <span class="caret" aria-hidden="true">▍</span>
      </div>

      <h1 class="h1-stagger">
        <span class="word" style="--i:0">Build</span>
        <span class="word" style="--i:1">consumer</span>
        <span class="word" style="--i:2">crypto</span>
        <span class="word" style="--i:3">apps</span>
        <span class="break"></span>
        <span class="word dim" style="--i:4">without</span>
        <span class="word dim" style="--i:5">rebuilding</span>
        <span class="word dim" style="--i:6">identity,</span>
        <span class="word dim" style="--i:7">accounts,</span>
        <span class="word dim" style="--i:8">and</span>
        <span class="word dim" style="--i:9">UX.</span>
      </h1>

      <p class="lede" data-reveal>
        Independent architecture comparisons and implementation guides covering smart
        accounts, gasless onboarding, onchain profiles, permissions, social primitives, and
        digital assets across Ethereum, EVM L2s, Solana, and LUKSO. LUKSO repeatedly emerges
        from the evidence as the most integrated EVM stack for profile-native consumer
        applications — see <a class="ledelink" href="/benchmarks/consumer-blockchain-architecture/">the benchmark</a>.
      </p>
      <div class="cta-row" data-reveal>
        <a class="cta magnetic" href="/best-blockchain/consumer-apps/">
          <span class="bracket">[</span>
          <span class="label">pick the chain</span>
          <span class="arrow">→</span>
          <span class="bracket">]</span>
        </a>
        <span class="cta-meta">or read <a href="/architecture/consumer-crypto-stack/">the architecture stack</a></span>
      </div>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('.hero.has-halo');
    if (hero) {
      let raf = 0;
      let nextX = 50, nextY = 30;
      const apply = () => {
        hero.style.setProperty('--cx', `${nextX}%`);
        hero.style.setProperty('--cy', `${nextY}%`);
        raf = 0;
      };
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        nextX = ((e.clientX - r.left) / r.width) * 100;
        nextY = ((e.clientY - r.top) / r.height) * 100;
        hero.dataset.halo = 'on';
        if (!raf) raf = requestAnimationFrame(apply);
      });
      hero.addEventListener('pointerleave', () => { hero.dataset.halo = ''; });
    }

    document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
      const PULL = 0.22;
      const RANGE = 90;
      let raf = 0;
      const apply = (dx: number, dy: number) => {
        el.style.setProperty('--mx', `${dx}px`);
        el.style.setProperty('--my', `${dy}px`);
        raf = 0;
      };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy);
        if (dist > RANGE) return;
        el.dataset.magnetize = 'on';
        if (!raf) raf = requestAnimationFrame(() => apply(dx * PULL, dy * PULL));
      });
      el.addEventListener('pointerleave', () => {
        el.dataset.magnetize = '';
        el.style.setProperty('--mx', '0px');
        el.style.setProperty('--my', '0px');
      });
    });
  </script>

  <section class="band decide" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">decide · best blockchain for…</span>
        <h2>Pick a chain by use case.</h2>
        <p class="dim">Same architecture criteria, different weighting per use case. Honest verdicts about when each chain wins.</p>
      </div>
      <ul class="vert-grid">
        {decide.map(v => (
          <li>
            <a class="vert" href={v.href}>
              <span class="vert-label">{v.label}</span>
              <span class="vert-stack">{v.use}</span>
              <span class="vert-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band architect" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">architect · patterns before chain</span>
        <h2>Decide the pattern first.</h2>
        <p class="dim">Every consumer crypto app makes six architecture decisions — accounts, identity, permissions, onboarding, metadata, social. Pick the pattern; the chain follows.</p>
      </div>
      <ul class="vert-grid four">
        {architect.map(v => (
          <li>
            <a class="vert" href={v.href}>
              <span class="vert-label">{v.label}</span>
              <span class="vert-stack">{v.pattern}</span>
              <span class="vert-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band compare" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">compare · head-to-head</span>
        <h2>Cross-chain comparisons + the open benchmark.</h2>
      </div>
      <ul class="query-list">
        {compare.map(({ label, href }) => (
          <li>
            <a class="query-row" href={href}>
              <span class="q">{label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band verticals" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">build · reading lists by vertical</span>
        <h2>Pick a vertical. Get a reading list.</h2>
      </div>
      <ul class="vert-grid">
        {verticals.map(v => (
          <li>
            <a class="vert" href={v.href}>
              <span class="vert-label">{v.label}</span>
              <span class="vert-stack">{v.stack}</span>
              <span class="vert-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="example">
    <div class="example-inner">
      <div class="example-head">
        <span class="eyebrow">standards & problems · the pattern, in one example</span>
        <h2 class="example-title">ERCs are interfaces. LSPs are <span class="solved">the system.</span></h2>
        <p class="dim">
          A signature comparison. The <span class="amber">−</span> line is the ERC surface you
          inherit. The <span class="pink">+</span> line is the LSP design you can build around.
        </p>
      </div>
      <div data-reveal>
        <DiffArrow
          size="lg"
          framed
          animated
          from={{
            chip: 'ERC-20',
            code: 'approve(spender, amount)',
            tags: ['unbounded', 'phishable', 'split-intent'],
          }}
          to={{
            chip: 'LSP7',
            code: 'authorizeOperator(op, amount, data)',
            tags: ['scoped', 'revocable', 'LSP6 account permissions'],
          }}
        />
      </div>
      <p class="example-foot dim">
        Read the full page →
        <a href="/problems/erc20-approval-risks/">erc20 approval risks</a>
      </p>
    </div>
  </section>

  <section class="band queries" data-reveal>
    <div class="band-inner">
      <div class="band-head">
        <span class="eyebrow">common ERC pain points</span>
        <h2>Start where your ERC design is breaking down.</h2>
      </div>
      <ul class="query-list">
        {commonPainPoints.map(({ q, a, href }) => (
          <li>
            <a class="query-row pain" href={href}>
              <span class="q">{q}</span>
              <span class="arrow" aria-hidden="true">→</span>
              <span class="a">{a}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="footnote">
    <div class="footnote-inner">
      <Authorship
        author="ercs-solved maintainers"
        updated="2026-06-29"
        editHref="https://github.com/tehnalogos/erc-solved/edit/main/src/pages/index.astro"
      />
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: var(--s-8) var(--s-5) var(--s-6);
    overflow: hidden;
  }
  .hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--s-5);
    position: relative;
    min-width: 0;
  }
  .hero-inner > * { min-width: 0; max-width: 100%; }
  .boot { max-width: 100%; overflow: hidden; }

  h1 {
    max-width: 22ch;
    font-size: clamp(36px, 5.5vw, 68px);
    font-variation-settings: 'opsz' 60;
    line-height: 1.04;
  }
  h1 .word { margin-right: 0.22em; }
  h1 .word.dim { color: var(--ink-bone-dim); }
  h1 .break { display: block; height: 0; }
  h1 .dim { color: var(--ink-bone-dim); }

  .lede {
    max-width: 72ch;
    font-size: var(--t-mono-md);
    color: var(--ink-bone-dim);
  }
  .lede .ledelink {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .lede .ledelink:hover { color: var(--signal-pink); border-color: var(--signal-pink); }

  .cta-row {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: var(--s-3);
  }
  .cta {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--ink-bone);
    color: var(--ink-bone);
    font-family: var(--font-mono);
    font-size: var(--t-mono-md);
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .cta:hover, .cta:focus-visible {
    background: var(--signal-pink);
    color: var(--ink-black);
    border-color: var(--signal-pink);
    outline: none;
  }
  .cta .bracket { color: var(--ink-fog); }
  .cta:hover .bracket { color: var(--ink-black); }
  .cta-meta { font-size: var(--t-mono-sm); color: var(--ink-fog); }
  .cta-meta a {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .cta-meta a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }

  .band { padding: var(--s-9) var(--s-5); border-top: 1px solid var(--ink-line); }
  .band-inner { max-width: var(--container); margin: 0 auto; display: grid; gap: var(--s-6); }
  .band-head { display: grid; gap: var(--s-3); max-width: 72ch; }
  .band-head h2 { font-size: clamp(28px, 3.5vw, 44px); }
  .band-head p.dim { color: var(--ink-bone-dim); }

  .vert-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink-line);
    border-left: 1px solid var(--ink-line);
  }
  .vert-grid.four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .vert {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: baseline;
    column-gap: var(--s-3);
    padding: var(--s-5);
    border-right: 1px solid var(--ink-line);
    border-bottom: 1px solid var(--ink-line);
    transition: background 150ms ease;
  }
  .vert:hover, .vert:focus-visible { background: var(--ink-paper); outline: none; }
  .vert-label {
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 36;
    font-size: 22px;
    color: var(--ink-bone);
    line-height: 1.15;
  }
  .vert-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-fog);
    font-size: 20px;
  }
  .vert:hover .vert-arrow { color: var(--signal-pink); }
  .vert-stack {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--signal-pink);
    margin-top: var(--s-2);
  }

  .query-list {
    display: grid;
    border-top: 1px solid var(--ink-line);
  }
  .query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-2);
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
  }
  .query-row.pain {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }
  .query-row .q { color: var(--ink-bone); font-size: var(--t-mono-md); }
  .query-row.pain .q { color: var(--erc-sand); }
  .query-row .arrow { color: var(--ink-line); }
  .query-row .a { color: var(--signal-pink); font-size: var(--t-mono-md); }
  .query-row:hover { background: var(--ink-paper); }
  .query-row:hover .arrow { color: var(--ink-bone); }

  .example {
    padding: var(--s-7) var(--s-5) var(--s-9);
    border-top: 1px solid var(--ink-line);
  }
  .example-inner {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    gap: var(--s-5);
  }
  .example-head { display: grid; gap: var(--s-3); }
  .example-title {
    font-size: clamp(28px, 3.5vw, 44px);
    max-width: 18ch;
  }
  .example-title .solved { color: var(--signal-pink); }
  .example-head p { max-width: 64ch; }
  .amber { color: var(--erc-sand); font-family: var(--font-mono); }
  .pink  { color: var(--signal-pink); font-family: var(--font-mono); }

  .example-foot { font-size: var(--t-mono-sm); }
  .example-foot a {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .example-foot a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }

  .footnote { padding: 0 var(--s-5) var(--s-7); }
  .footnote-inner { max-width: var(--container); margin: 0 auto; }

  @media (max-width: 900px) {
    .vert-grid { grid-template-columns: 1fr; }
    .vert-grid.four { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: var(--s-7) var(--s-4) var(--s-5); }
    .band { padding: var(--s-7) var(--s-4); }
    .example { padding: var(--s-6) var(--s-4) var(--s-7); }
    .query-row.pain { grid-template-columns: 1fr; gap: var(--s-1); padding: var(--s-3) 0; }
    .query-row.pain .arrow { display: none; }
  }
</style>
