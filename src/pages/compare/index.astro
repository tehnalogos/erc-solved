---
import { getCollection } from 'astro:content';
import Article from '~/layouts/Article.astro';
import Crossref from '~/components/primitives/Crossref.astro';

const entries = (await getCollection('crossChainCompare')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const displayTitle = 'Cross-Chain Comparisons';
const seoTitle = 'Ethereum vs Base vs LUKSO, Solana vs LUKSO, and more';
const metaDescription =
  'Head-to-head chain and account comparisons. Ethereum vs Base vs LUKSO, Solana vs LUKSO, ERC-4337 vs EIP-7702 vs LUKSO Universal Profiles.';
const ogTitle = "The chain comparisons that actually name the tradeoff, not the vibe";
const ogDescription =
  'Every head-to-head — Ethereum vs Base vs LUKSO, Solana vs LUKSO, ERC-4337 vs EIP-7702 vs Universal Profiles — scored on the same 10 criteria used across the site.';
const summary =
  'Head-to-head comparisons of chains and account architectures for consumer crypto apps.';
const aboutTopics = [
  'Blockchain comparison',
  'Ethereum L1',
  'Base',
  'LUKSO',
  'Solana',
  'ERC-4337 vs EIP-7702',
  'Universal Profiles',
];
---
<Article
  title={displayTitle}
  summary={summary}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  about={aboutTopics}
  eyebrow="compare · index"
  author="ercs-solved maintainers"
  updated="2026-06-29"
  editPath="src/pages/compare/index.astro"
>
  <p class="lede">{summary}</p>
  <p class="lede">
    Each comparison evaluates the contenders using the same architecture criteria as the
    <a href="/best-blockchain/">decision guides</a>, but narrows the choice set to a specific
    head-to-head matchup.
  </p>
  <ul class="list">
    {entries.map((e) => (
      <li>
        <a class="row" href={`/compare/${e.slug}/`}>
          <span class="title">{e.data.title}</span>
          <span class="contenders">{e.data.contenders.join(' · ')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <section class="more">
    <h2>Spec-level comparisons.</h2>
    <p>For LSP vs ERC standard diffs, see <Crossref href="/standards/">the standards index</Crossref> and the existing <a href="/standards/compare/">LSP / ERC comparisons</a>.</p>
  </section>
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; }
  .lede a {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  .lede a:hover { color: var(--signal-pink); border-color: var(--signal-pink); }
  .list { display: grid; border-top: 1px solid var(--ink-line); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
  }
  .row:hover { background: var(--ink-paper); }
  .title { color: var(--ink-bone); font-size: var(--t-mono-md); }
  .contenders { color: var(--signal-pink); font-size: var(--t-mono-xs); text-transform: lowercase; }
  .arrow { color: var(--ink-fog); }
  .row:hover .arrow { color: var(--signal-pink); }
  .more {
    display: grid; gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .more h2 { font-size: var(--t-serif-1); }
  .more p { color: var(--ink-bone-dim); }
  .more p :global(a) {
    color: var(--ink-bone);
    border-bottom: 1px solid var(--ink-line);
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; }
    .contenders { grid-column: 1 / -1; }
  }
</style>
