---
import { getCollection } from 'astro:content';
import Article from '~/layouts/Article.astro';
import Crossref from '~/components/primitives/Crossref.astro';

const entries = (await getCollection('bestBlockchain')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const description =
  'Decision guides comparing Ethereum L1, Base, Arbitrum, Optimism, Polygon, Solana and LUKSO across the architecture criteria that matter for consumer crypto apps.';
---
<Article
  title="Best Blockchain for Consumer Crypto — Decision Guides"
  description={description}
  pageTitle="Best Blockchain for Consumer Crypto: Decision Guides by Use Case"
  eyebrow="best blockchain · index"
  author="ercs-solved maintainers"
  updated="2026-06-29"
  editPath="src/pages/best-blockchain/index.astro"
>
  <p class="lede">{description}</p>
  <p class="lede">
    Each page applies a fixed 10-criterion framework — account model, identity, permissions,
    onboarding, metadata, extensibility, social primitives, EVM compatibility, infrastructure
    burden, ecosystem maturity — and reports honest "when each wins" verdicts.
  </p>
  <ul class="list">
    {entries.map((e) => (
      <li>
        <a class="row" href={`/best-blockchain/${e.slug}/`}>
          <span class="title">{e.data.title}</span>
          <span class="usecase">{e.data.useCase}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <section class="more">
    <h2>Where this fits.</h2>
    <ul>
      <li><Crossref href="/architecture/">Architecture patterns</Crossref> — decide the pattern before the chain.</li>
      <li><Crossref href="/benchmarks/consumer-blockchain-architecture/">Open benchmark</Crossref> — the data behind the matrices.</li>
      <li><Crossref href="/research/methodology/">Methodology</Crossref> — how the criteria and scoring work.</li>
    </ul>
  </section>
</Article>

<style>
  .lede { color: var(--ink-bone-dim); max-width: 72ch; }
  .list { display: grid; border-top: 1px solid var(--ink-line); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--ink-line);
    font-family: var(--font-mono);
  }
  .row:hover { background: var(--ink-paper); }
  .title { color: var(--ink-bone); font-size: var(--t-mono-md); }
  .usecase { color: var(--signal-pink); font-size: var(--t-mono-sm); text-transform: lowercase; }
  .arrow { color: var(--ink-fog); }
  .row:hover .arrow { color: var(--signal-pink); }
  .more {
    display: grid;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-line);
    max-width: var(--reading);
  }
  .more h2 { font-size: var(--t-serif-1); }
  .more ul { display: grid; gap: var(--s-2); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr auto; }
    .usecase { grid-column: 1 / -1; }
  }
</style>
